# -- Azure AI Foundry Project -----------------------------------------------------------------
# Find all values in: Foundry portal ? your project ? Overview
PROJECT_ENDPOINT=<Project-Endpoint-Of-Foundry>
AZURE_OPENAI_ENDPOINT=<Azure-OpenAI-Endpoint-Of-Foundry>

# Required by AIProjectClient.get_openai_client() to build its OpenAI-compatible client.
OPENAI_API_VERSION=2024-10-21

# -- Model deployment names (Build > Models in the Foundry portal) --
MODEL_DEPLOYMENT_NAME=gpt-5.4
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large
MICROSOFT_MODEL=Phi-4-reasoning
MODEL_NAME=DeepSeek-V3.2

# -- Azure AI Search (Exercises 3 and 6) --
SEARCH_ENDPOINT=<Search-Service-URL>
SEARCH_API_KEY=<Search-Service-Primary-Admin-Key>
SEARCH_CONNECTION_NAME=<Search-Service-Connection-Name-In-Foundry>
SEARCH_INDEX_NAME=healthtips-index

# -- Connections ------------------------------------------------------------------------------
# Used by: 4-bing_grounding.ipynb
GROUNDING_WITH_BING_CONNECTION_NAME=BingSearch

# -- Observability (Exercise 5) --
APPLICATIONINSIGHTS_CONNECTION_STRING=<Application-Insight-Connection-String>
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true

# -- Azure identity (Exercise 2 authentication) --
TENANT_ID=<Azure-Tenant-ID>
AZURE_SUBSCRIPTION_ID=<Azure-Subscription-ID>
